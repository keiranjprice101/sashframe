[Unit]
Description=Sashframe Application (Known-Good Container Launch)
Documentation=https://github.com/keiranjprice101/sashframe
Wants=docker.service
After=docker.service
Before=sashframe-kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ sashframe_user }}
WorkingDirectory={{ sashframe_app_dir }}
EnvironmentFile={{ sashframe_config_root }}/sashframe.env
ExecStart=/bin/bash {{ sashframe_app_dir }}/scripts/start-app.sh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
