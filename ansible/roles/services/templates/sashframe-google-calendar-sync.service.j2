[Unit]
Description=Sashframe Google Calendar Sync
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User={{ sashframe_user }}
WorkingDirectory={{ sashframe_app_dir }}
EnvironmentFile={{ sashframe_config_root }}/sashframe.env
ExecStart=/bin/bash {{ sashframe_app_dir }}/scripts/sync-google-calendar.sh
TimeoutStartSec=240
StandardOutput=journal
StandardError=journal
