[Unit]
Description=Sashframe Google Drive Shifter Calendar Sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ sashframe_user }}
WorkingDirectory={{ sashframe_app_dir }}
EnvironmentFile={{ sashframe_config_root }}/sashframe.env
ExecStart=/bin/bash {{ sashframe_app_dir }}/scripts/sync-shifter.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
