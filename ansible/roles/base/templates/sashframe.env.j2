# Sashframe Environment Configuration
# Managed by Ansible - do not edit directly
PHOTO_INPUT_DIR={{ sashframe_data_root }}/photos/incoming
PHOTO_OUTPUT_DIR={{ sashframe_data_root }}/photos/processed
PHOTO_MANIFEST={{ sashframe_data_root }}/photos/manifest.json
PHOTO_MAX_SIZE={{ sashframe_photo_max_size }}
PHOTO_QUALITY={{ sashframe_photo_quality }}

# Google Drive Photo Sync Settings
PHOTO_DRIVE_FOLDER_ID={{ sashframe_photo_drive_folder_id }}
RCLONE_REMOTE={{ sashframe_rclone_remote }}
RCLONE_PHOTO_PATH="{{ sashframe_rclone_photo_path }}"

# Host rclone & Shifter Calendar Sync Settings
RCLONE_CONFIG={{ sashframe_rclone_config }}
RCLONE_SHIFTER_REMOTE={{ sashframe_rclone_shifter_remote }}
RCLONE_SHIFTER_FOLDER_ID={{ sashframe_shifter_drive_folder_id }}
SHIFTER_DRIVE_FOLDER_ID={{ sashframe_shifter_drive_folder_id }}
SHIFTER_INPUT_DIR={{ sashframe_data_root }}/calendar
SHIFTER_FILE_PATH={{ sashframe_data_root }}/calendar/calendar.Shifter

# Google Service Account Credentials
GOOGLE_SERVICE_ACCOUNT_FILE={{ sashframe_google_service_account_dest }}
RCLONE_SHIFTER_SERVICE_ACCOUNT={{ sashframe_google_service_account_dest }}

# Appliance Timezone & Geo Coordinates
SASHFRAME_TIMEZONE={{ sashframe_timezone }}
SASHFRAME_LATITUDE={{ sashframe_latitude }}
SASHFRAME_LONGITUDE={{ sashframe_longitude }}
WEATHER_LATITUDE={{ sashframe_latitude }}
WEATHER_LONGITUDE={{ sashframe_longitude }}

# Household Configuration
SASHFRAME_HOUSEHOLD_CONFIG={{ sashframe_household_config_dest }}

# Container Process User Mapping
PUID={{ sashframe_puid }}
PGID={{ sashframe_pgid }}

# Canonical Host Storage Directories
SASHFRAME_DATA_DIR={{ sashframe_data_root }}
SASHFRAME_PHOTOS_DIR={{ sashframe_data_root }}/photos
SASHFRAME_CALENDAR_DIR={{ sashframe_data_root }}/calendar
SASHFRAME_STATE_DIR={{ sashframe_data_root }}/state
SASHFRAME_DATABASE_DIR={{ sashframe_data_root }}/database
