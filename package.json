{
  "name": "sashframe",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "bash scripts/install.sh --dev",
    "dev": "astro dev",
    "dev:astro": "astro dev",
    "photos:process": "bash -c 'if [ -f .venv/bin/python3 ]; then .venv/bin/python3 -m services.photos.process; elif command -v python3 >/dev/null 2>&1; then python3 -m services.photos.process; else docker compose run --rm sashframe-photo-processor; fi'",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "prod:up": "docker compose --env-file /etc/sashframe/sashframe.env up -d",
    "prod:down": "docker compose --env-file /etc/sashframe/sashframe.env down",
    "prod:logs": "docker compose --env-file /etc/sashframe/sashframe.env logs -f",
    "prod:ps": "docker compose --env-file /etc/sashframe/sashframe.env ps",
    "start": "bash scripts/start.sh",
    "kiosk": "bash scripts/start.sh",
    "kiosk:boot": "bash scripts/start.sh --setup-boot",
    "kiosk:status": "bash scripts/start.sh --status",
    "daemon": "python3 daemon.py",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.ts && (if [ -f .venv/bin/python3 ]; then .venv/bin/python3 -m unittest discover tests; else python3 -m unittest discover tests; fi)"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4"
  }
}
