{
  "name": "sashframe",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "bash scripts/install.sh --dev",
    "dev": "bash scripts/dev.sh",
    "dev:astro": "astro dev",
    "dev:photos": "bash -c 'if [ -f .venv/bin/python3 ]; then .venv/bin/python3 services/photos/processor.py; else python3 services/photos/processor.py; fi'",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "prod:up": "docker compose up -d",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f",
    "prod:ps": "docker compose ps",
    "prod:update": "bash scripts/update.sh",
    "start": "docker compose up -d",
    "daemon": "python3 daemon.py",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4"
  }
}
