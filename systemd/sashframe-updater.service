[Unit]
Description=Sashframe Power-On Software Auto-Updater
Documentation=https://github.com/keiranjprice101/sashframe
Wants=network-online.target
After=network-online.target docker.service sashframe-app.service

[Service]
Type=oneshot
User=@INSTALL_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/sashframe/sashframe.env
ExecStart=/bin/bash @REPO_ROOT@/scripts/update.sh
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
