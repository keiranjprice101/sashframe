[Unit]
Description=Sashframe Application (Known-Good Container Launch)
Documentation=https://github.com/keiranjprice101/sashframe
Wants=docker.service
After=docker.service
Before=sashframe-kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@INSTALL_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/sashframe/sashframe.env
ExecStart=/bin/bash @REPO_ROOT@/scripts/start-app.sh
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
