[Unit]
Description=Sashframe Google Drive Photo Sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@INSTALL_USER@
EnvironmentFile=/etc/sashframe/sashframe.env
ExecStart=/bin/bash @REPO_ROOT@/scripts/sync-photos.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
