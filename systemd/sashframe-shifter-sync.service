[Unit]
Description=Sashframe Google Drive Shifter Calendar Sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@INSTALL_USER@
EnvironmentFile=-/etc/sashframe/sashframe.env
EnvironmentFile=-/etc/home-calendar/home-calendar.env
ExecStart=/bin/bash @REPO_ROOT@/scripts/sync-shifter.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
