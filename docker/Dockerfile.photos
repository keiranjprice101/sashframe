# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PHOTO_INPUT_DIR=/data/photos/incoming \
    PHOTO_OUTPUT_DIR=/data/photos/processed \
    PHOTO_MANIFEST=/data/photos/manifest.json \
    PHOTO_MAX_SIZE=1920 \
    PHOTO_QUALITY=85

# Install gosu for root-to-unprivileged user privilege dropping
RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Create application user with standard non-root UID 1000
RUN groupadd -g 1000 appuser \
    && useradd -u 1000 -g appuser -m -s /bin/bash appuser

# Copy photo processing service code and entrypoint
COPY services/ ./services/
COPY docker/entrypoint-photos.sh ./docker/entrypoint-photos.sh
RUN chmod +x ./docker/entrypoint-photos.sh

ENTRYPOINT ["/app/docker/entrypoint-photos.sh"]
CMD ["python3", "-m", "services.photos.process"]
