# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/test-venv

ENV PATH="/opt/test-venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1

COPY package.json package-lock.json requirements.txt requirements-calendar.txt ./
RUN npm ci \
    && python3 -m pip install --no-cache-dir -r requirements.txt -r requirements-calendar.txt

# Include only code needed by the suites; keep local data and credentials out.
COPY src ./src
COPY services ./services
COPY scripts ./scripts
COPY tests ./tests

CMD ["npm", "test"]
