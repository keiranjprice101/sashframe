FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GOOGLE_CALENDAR_CACHE=/data/calendar/google.json \
    SASHFRAME_TIMEZONE=Europe/London \
    HOME=/tmp

COPY requirements-calendar.txt ./
RUN pip install --no-cache-dir -r requirements-calendar.txt
COPY services/calendar ./services/calendar

# Compose supplies the host UID/GID and mounts credentials read-only.
USER 1000:1000
CMD ["python3", "-m", "services.calendar.sync"]
